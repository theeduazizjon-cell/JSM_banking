# Copy to .env.local and fill in. Never commit real values.
# Setup steps for each service are in README.md.

#APPWRITE (console > project > Overview)
# Use your project's regional endpoint, e.g. https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_BANK_COLLECTION_ID=
APPWRITE_TRANSACTION_COLLECTION_ID=
# Server API key with scopes: users.read, users.write, sessions.write, documents.read, documents.write
NEXT_APPWRITE_KEY=

#PLAID (https://dashboard.plaid.com/developers/keys)
# The Dwolla integration must be enabled for these keys (Developers > Integrations)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production; anything else falls back to sandbox
PLAID_ENV=sandbox

#DWOLLA (https://dashboard-sandbox.dwolla.com/applications-legacy)
DWOLLA_KEY=
DWOLLA_SECRET=
# Must be sandbox or production; the app refuses to start transfers otherwise
DWOLLA_ENV=sandbox

#SECURITY
# Encrypts Plaid access tokens at rest. Generate with: openssl rand -base64 32
# Don't change it once tokens are stored: they can't be decrypted with a new key.
ENCRYPTION_KEY=

#SENTRY (optional; leave the DSN empty to turn Sentry off)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps. The org and project are set in next.config.ts.
SENTRY_AUTH_TOKEN=

#END-TO-END TESTS (npm run test:e2e)
# A sandbox account created through the app's sign-up page
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
